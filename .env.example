# Copy to .env. Everything here is optional for local use except the two owner lines.
VAP_ENVIRONMENT=development          # production turns on Secure cookies and HSTS, and hides /api/docs
VAP_HOST=127.0.0.1
VAP_PORT=8000
VAP_PUBLIC_ORIGIN=http://localhost:8000

# The first owner account. Created once, on first start. Use your own values.
VAP_ADMIN_EMAIL=owner@example.test
VAP_ADMIN_PASSWORD=change-me-to-10-or-more-characters-1

# Behind a tunnel or reverse proxy, set this to true. See docs/10_SECURITY.md.
VAP_TRUST_PROXY=false

# Local language model. Any OpenAI-compatible server works.
VAP_LLM_PROVIDER=llama-server
VAP_LLM_BASE_URL=http://127.0.0.1:8081/v1
VAP_LLM_API_KEY=
VAP_LLM_MODEL=
VAP_LLM_MANAGE_PROCESS=true
VAP_LLM_CTX_SIZE=2048
VAP_LLM_MAX_TOKENS=160
# Load the model even when free memory looks short. Used on a busy 16 GB laptop.
VAP_LLM_ALLOW_LOW_MEMORY=false

# Limits. VAP_MAX_SESSIONS=0 takes the number from the hardware plan.
VAP_MAX_SESSIONS=0
VAP_MAX_UPLOAD_MB=25
VAP_RATE_LIMIT_PER_MINUTE=120
VAP_MIN_FREE_RAM_GB=0.3
