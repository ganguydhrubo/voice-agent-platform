{
  "title": "Voice Agent",
  "uid": "voice-agent",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Live conversations",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "vap_active_sessions" }]
    },
    {
      "id": 2,
      "title": "Turns per minute",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(rate(vap_turns_total[5m])) * 60", "legendFormat": "turns" }]
    },
    {
      "id": 3,
      "title": "Refused conversations",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "targets": [{ "expr": "sum by (reason) (rate(vap_sessions_rejected_total[5m])) * 60", "legendFormat": "{{reason}}" }]
    },
    {
      "id": 4,
      "title": "95th percentile by stage (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(vap_stage_ms_bucket[5m])))", "legendFormat": "{{stage}}" }]
    },
    {
      "id": 5,
      "title": "Waiting jobs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 6 },
      "targets": [{ "expr": "vap_queue_depth", "legendFormat": "{{pool}}" }]
    },
    {
      "id": 6,
      "title": "Escalations and interruptions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 6 },
      "targets": [
        { "expr": "sum by (severity) (rate(vap_escalations_total[5m])) * 60", "legendFormat": "{{severity}}" },
        { "expr": "rate(vap_barge_ins_total[5m]) * 60", "legendFormat": "interruptions" }
      ]
    }
  ]
}
